[user]
  email = ivan.klishch@datadoghq.com
	name = Ivan Klishch
  ; signingkey = 6E3BEDE996CB8103
[core]
	; hooksPath = /usr/local/dd/global_hooks
	editor = nvim
  autocrlf = input
	excludesfile = ~/.gitignore_global
  whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol
	hooksPath = /usr/local/dd/global_hooks

[diff]
	mnemonicPrefix = true
	renames = true
	colorMoved = default

[help]
	autocorrect = prompt

[merge]
	tool = vimdiff

[rebase]
	autosquash = true
	updateRefs = true

[color]
  ui = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
  whitespace = red reverse
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[commit]
	gpgsign = true
[tag]
	forceSignAnnotated = true
	gpgsign = true
	sort = version:refname

[remote "origin"]
;fetch = +refs/tags/*:refs/tags/*
;fetch = +refs/heads/*:refs/remotes/origin/*



; [gpg]
; 	program = /Users/ivan.klishch/.local/bin/yubinotif
; 	format = ssh
[alias]
  st = status
  dc = diff --cached
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit
  ls = ls-files
  default-branch = ! git config get --default $(git rev-parse --abbrev-ref origin/HEAD | sed 's|^origin/||') branch.overridden-default
  force-default-branch = "!f() { git config set "branch.overridden-default" "${1}"; }; f"
  unforce-default-branch = config unset "branch.overridden-default"
  up = "!f() { git pull --rebase origin "${1:-$(git default-branch)}"; }; f"
  s = status --short --branch
  web-url = ! [[ "$(git remote get-url --push $(git remote show | head -1))" =~ ^.*@(.*)[:/](.*)/(.*)$ ]] && printf -- 'https://%s/%s/%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]%.git}"
  web = ! open "$(git web-url)"

[url "git@github.com:"]
  insteadOf = https://github.com
; [fetch]
;   prune = true
; 	pruneTags = true

[pull]
  rebase = merges

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[gpg]
	program = /opt/homebrew/bin/gpg
  format = ssh
[safe]
	directory = /Users/ivan.klishch/go/src/github.com/DataDog/dogweb/.git
	directory = /Users/ivan.klishch/go/src/github.com/DataDog/dd-source/.git
[maintenance]
	repo = /Users/ivan.klishch/go/src/github.com/DataDog/dd-source
	repo = /Users/ivan.klishch/Personal/dd-source
[rerere]
	enabled = true
[include]
	path = /Users/ivan.klishch/.config/datadog/git/config
